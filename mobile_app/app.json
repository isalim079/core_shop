{
  "expo": {
    "name": "Core Shop",
    "slug": "core-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cs-icon.png",
    "scheme": "coreshop",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "image": "./assets/images/cs-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coreshop.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/cs-icon.png"
      },
      "package": "com.coreshop.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "react-native-keyboard-controller",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/cs-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
