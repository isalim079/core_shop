# Safe template: copy to .env.local. Never put real secrets in this example.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# PostgreSQL is required outside tests. Use a restricted application login.
# Use a separate schema-owner connection for migrations and reference seed.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000

# Reserved for later Redis integration.
REDIS_URL=
