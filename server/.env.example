# Safe template: copy to .env.local. Never put real secrets in this example.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# PostgreSQL is required outside tests. Use a restricted application login.
# Use a separate schema-owner connection for migrations and reference seed.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000

# Reserved for later Redis integration.
REDIS_URL=

# Request security: trust only the actual reverse proxy addresses, never every proxy.
LOG_LEVEL=info
TRUST_PROXY_CIDRS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Selected provider; cloud integration is implemented in the files phase.
# Leave credentials empty until configured, or supply all four R2 settings together.
STORAGE_PROVIDER=cloudflare-r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Authentication: generate once with node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep stable across server instances. Empty disables credential authentication safely.
AUTH_SECRET=
# Comma-separated allowed Google OAuth client IDs. No client secret is needed for ID-token verification.
GOOGLE_CLIENT_IDS=

# Email verification/password recovery. TLS is required; never disable certificate verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS provider will be selected separately; phone verification is unavailable until its adapter is configured.
