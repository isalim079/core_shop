{
  "name": "core-shop-server",
  "version": "0.1.0",
  "private": true,
  "description": "Core Shop multi-tenant API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node scripts/start-production.cjs",
    "build": "nest build",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "check": "yarn db:validate && yarn db:generate && yarn lint && yarn typecheck && yarn test && yarn build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:integration": "yarn build && node scripts/database/test-local.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "^10.12.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
