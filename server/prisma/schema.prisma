generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum BranchAccess {
  ALL
  SELECTED
}

enum FilePurpose {
  USER_AVATAR
  ORGANIZATION_LOGO
  ORGANIZATION_COVER
  PRODUCT_IMAGE
  SALE_ATTACHMENT
  PURCHASE_ATTACHMENT
  DOCUMENT
}

enum FileStatus {
  PENDING
  UPLOADED
  QUARANTINED
  READY
  REJECTED
  DELETION_PENDING
  DELETED
  EXPIRED
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum PlatformRole {
  SUPPORT
  ADMIN
}

enum Language {
  en
  bn
}

enum CommandStatus {
  PROCESSING
  COMPLETED
}

enum OutboxStatus {
  PENDING
  DELIVERED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique @db.VarChar(254)
  phone           String?    @unique @db.VarChar(20)
  displayName     String     @db.VarChar(120)
  preferredLanguage Language @default(en)
  passwordHash    String?    @db.VarChar(255)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?  @db.Timestamptz(3)

  authSessions AuthSession[]
  authChallenges AuthChallenge[]
  googleIdentity GoogleIdentity?
  organizationCreations OrganizationCreation[]
  acceptedInvitations MembershipInvitation[] @relation("AcceptedInvitations")
  memberships Membership[]
  ownedFiles  StoredFile[]     @relation("PersonalFileOwner")
  uploads     StoredFile[]     @relation("FileUploader")
  avatar      UserAvatar?
  grants      PlatformGrant[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(160)
  status             OrganizationStatus @default(DRAFT)
  currency           String             @db.Char(3)
  currencyScale      Int                @default(2) @db.SmallInt
  timezone           String             @db.VarChar(80)
  quantityScale      Int                @default(3) @db.SmallInt
  allowNegativeStock Boolean            @default(false)
  address            String?            @db.VarChar(500)
  documentLanguage   String             @default("en") @db.VarChar(5)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt         DateTime?          @db.Timestamptz(3)

  creation OrganizationCreation?
  invitations MembershipInvitation[]
  memberships Membership[]
  branches    Branch[]
  roles       Role[]
  files       StoredFile[]
  branding    OrganizationBranding?
  auditEvents AuditEvent[]
  commands CommandRecord[]
  outboxEvents OutboxEvent[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  isOwner        Boolean          @default(false)
  branchAccess   BranchAccess     @default(SELECTED)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]
  branches     BranchGrant[]
  commands     CommandRecord[]
  auditEvents  AuditEvent[]
  sentInvitations MembershipInvitation[] @relation("InvitationSender")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@map("memberships")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(32)
  address        String?  @db.VarChar(500)
  name           String   @db.VarChar(160)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grants       BranchGrant[]
  auditEvents  AuditEvent[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("branches")
}

model Permission {
  code        String           @id @db.VarChar(80)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(40)
  name           String   @db.VarChar(80)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("roles")
}

model RolePermission {
  roleId         String @db.Uuid
  permissionCode String @db.VarChar(80)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String @db.Uuid
  membershipId   String @db.Uuid
  roleId         String @db.Uuid

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  role       Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([organizationId, roleId])
  @@map("membership_roles")
}

model BranchGrant {
  organizationId String @db.Uuid
  membershipId   String @db.Uuid
  branchId       String @db.Uuid

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  branch     Branch     @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, branchId])
  @@index([organizationId, branchId])
  @@map("branch_grants")
}

// Global operator permissions confer no organization membership or business-data access.
model PlatformGrant {
  userId    String       @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@map("platform_grants")
}

// Exactly one owner scope is required by a SQL CHECK constraint.
// Object bytes and expiring signed URLs never live in this table.
model StoredFile {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String?        @db.Uuid
  ownerUserId        String?        @db.Uuid
  uploadedByUserId    String         @db.Uuid
  purpose            FilePurpose
  status             FileStatus     @default(PENDING)
  scanStatus         FileScanStatus @default(PENDING)
  bucket             String         @db.VarChar(63)
  objectKey          String         @unique @db.VarChar(512)
  originalName       String         @db.VarChar(255)
  declaredMimeType   String         @db.VarChar(100)
  verifiedMimeType   String?        @db.VarChar(100)
  expectedBytes      BigInt
  uploadedBytes      BigInt?
  actualBytes        BigInt?
  sourceVersion      String?        @db.VarChar(255)
  sourceEtag         String?        @db.VarChar(128)
  finalObjectKey     String?        @unique @db.VarChar(512)
  finalEtag          String?        @db.VarChar(128)
  sha256             String?        @db.Char(64)
  storageVersion     String?        @db.VarChar(255)
  width              Int?
  height             Int?
  expiresAt          DateTime       @db.Timestamptz(3)
  verifiedAt         DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?         @relation("PersonalFileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation("FileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  avatar       UserAvatar[]
  logos        OrganizationBranding[] @relation("OrganizationLogo")
  covers       OrganizationBranding[] @relation("OrganizationCover")

  @@unique([ownerUserId, id])
  @@unique([organizationId, id])
  @@index([organizationId, purpose, status, createdAt])
  @@index([ownerUserId, purpose, status])
  @@index([status, expiresAt])
  @@index([uploadedByUserId])
  @@map("stored_files")
}

model UserAvatar {
  userId    String   @id @db.Uuid
  fileId    String   @unique @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [userId, fileId], references: [ownerUserId, id], onDelete: Restrict)

  @@map("user_avatars")
}

model OrganizationBranding {
  organizationId String   @id @db.Uuid
  logoFileId     String?  @db.Uuid
  coverFileId    String?  @db.Uuid
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  logo StoredFile? @relation("OrganizationLogo", fields: [organizationId, logoFileId], references: [organizationId, id], onDelete: Restrict)
  cover StoredFile? @relation("OrganizationCover", fields: [organizationId, coverFileId], references: [organizationId, id], onDelete: Restrict)

  @@index([logoFileId])
  @@index([coverFileId])
  @@map("organization_branding")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  branchId       String?  @db.Uuid
  actorId        String?  @db.Uuid
  requestId      String   @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String   @db.VarChar(60)
  entityId       String?  @db.Uuid
  metadata       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [organizationId, actorId], references: [organizationId, userId], onDelete: Restrict, map: "audit_membership_scope")

  @@index([organizationId, createdAt, id])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("audit_events")
}

model CommandRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  actorId        String        @db.Uuid
  operation      String        @db.VarChar(160)
  key            String        @db.VarChar(128)
  payloadHash    String        @db.Char(64)
  status         CommandStatus @default(PROCESSING)
  responseStatus Int?           @db.SmallInt
  result         Json?
  requestId      String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?     @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [organizationId, actorId], references: [organizationId, userId], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@unique([organizationId, actorId, operation, key])
  @@unique([organizationId, id])
  @@map("command_records")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  commandId      String       @db.Uuid
  eventType      String       @db.VarChar(80)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @db.Timestamptz(3)
  deliveredAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  command CommandRecord @relation(fields: [organizationId, commandId], references: [organizationId, id], onDelete: Restrict)

  @@unique([commandId, eventType])
  @@index([status, availableAt, id])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}


model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  clientKind String @db.VarChar(10)
  deviceName String @db.VarChar(80)
  accessHash String @unique @db.Char(64)
  accessExpiresAt DateTime @db.Timestamptz(3)
  csrfHash String @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens AuthRefreshToken[]
  @@index([userId, createdAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique @db.Char(64)
  usedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  channel String @db.VarChar(10)
  purpose String @db.VarChar(12)
  destination String @db.VarChar(254)
  secretHash String @db.Char(64)
  attempts Int @default(0) @db.SmallInt
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([expiresAt])
  @@index([userId, purpose])
  @@map("auth_challenges")
}

model GoogleIdentity {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  subject String @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("google_identities")
}

model AuthRateBucket {
  key String @id @db.Char(64)
  hits Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("auth_rate_buckets")
}


model OrganizationCreation {
  userId String @db.Uuid
  key String @db.Uuid
  payloadHash String @db.Char(64)
  organizationId String @unique @db.Uuid
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@id([userId, key])
  @@map("organization_creations")
}

model MembershipInvitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  invitedByUserId String @db.Uuid
  channel String @db.VarChar(5)
  destination String @db.VarChar(254)
  status String @default("PENDING") @db.VarChar(8)
  branchAccess BranchAccess
  roleIds String[] @db.Uuid
  branchIds String[] @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  acceptedByUserId String? @db.Uuid
  acceptedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sender Membership @relation("InvitationSender", fields: [organizationId, invitedByUserId], references: [organizationId, userId], onDelete: Restrict)
  acceptedBy User? @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  @@index([channel, destination, status, expiresAt])
  @@index([organizationId, createdAt, id])
  @@map("membership_invitations")
}
